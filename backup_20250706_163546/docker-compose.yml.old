version: '3.8'

services:
  # ===== BACKEND =====
  # Connecté aux deux réseaux : public (pour les API) et privé (pour la DB)
  backend:
    build: ./back_end
    ports:
      - "5001:5000"  # Exposé sur le réseau public
    volumes:
      - ./back_end:/app
      - ./data:/app/data
      - ./models:/app/models
    environment:
      - DATABASE_URL=postgresql://postgres:0000@db:5432/books_db
    depends_on:
      - db
    networks:
      - public-network   # Pour recevoir les requêtes du frontend
      - private-network  # Pour communiquer avec la base de données
    restart: unless-stopped

  # ===== FRONTEND =====
  # Connecté seulement au réseau public
  frontend:
    build: ./front_end
    ports:
      - "5173:5173"  # Exposé au public
    volumes:
      - ./front_end:/app
      - /app/node_modules
    environment:
      - VITE_API_URL=http://localhost:5001/api
    depends_on:
      - backend
    networks:
      - public-network   # Seulement sur le réseau public
    restart: unless-stopped

  # ===== BASE DE DONNÉES =====
  # Connectée seulement au réseau privé (isolée du public)
  db:
    image: postgres:14
    # Pas de ports exposés vers l'extérieur = sécurité renforcée
    environment:
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=0000
      - POSTGRES_DB=books_db
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
      - private-network  # Seulement sur le réseau privé
    restart: unless-stopped

# ===== CONFIGURATION RÉSEAUX =====
networks:
  # Réseau public : Frontend <-> Backend
  public-network:
    driver: bridge
    name: bookfav-public
    ipam:
      config:
        - subnet: 172.20.0.0/16
          gateway: 172.20.0.1

  # Réseau privé : Backend <-> Database
  private-network:
    driver: bridge
    name: bookfav-private
    internal: false  # false car le backend a besoin d'accès externe pour les APIs
    ipam:
      config:
        - subnet: 172.21.0.0/16
          gateway: 172.21.0.1

volumes:
  postgres-data: 