        <mxCell id="mlp-details" value="• Concatenation des embeddings&#xa;• Couches denses: 128 → 64 → 32&#xa;• Dropout: 30% pour régularisation&#xa;• Fonctions d&#39;activation: ReLU" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="mlp-branch" vertex="1">
