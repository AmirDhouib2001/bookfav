        <!-- Informations techniques -->
        <mxCell id="tech-info" value="Informations Techniques" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;" vertex="1" parent="1">
          <mxGeometry x="450" y="260" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tech-details" value="Durée typique: 15-20 minutes&#10;Fréquence: Tous les 100 nouveaux ratings&#10;Ressources: 90% CPU, 2GB RAM&#10;Stockage: Modèle ~500MB&#10;Thread pool: 1 worker asynchrone&#10;Timeout: 30 minutes max&#10;Rollback: Automatique en cas d'échec&#10;Monitoring: Métriques temps réel&#10;Notification: Slack/Email en cas d'erreur" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="tech-info">
          <mxGeometry y="30" width="300" height="170" as="geometry" />
        </mxCell>
        
        <!-- Métriques de succès -->
        <mxCell id="success-metrics" value="Métriques de Succès" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00695c;" vertex="1" parent="1">
          <mxGeometry x="450" y="80" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="success-details" value="• RMSE nouveau ≤ RMSE ancien + 0.05&#10;• MAE nouveau ≤ MAE ancien + 0.03&#10;• Taux de convergence ≥ 90%&#10;• Temps d'entraînement ≤ 25 minutes&#10;• Pas de NaN dans les prédictions&#10;• Validation croisée stable" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="success-metrics">
          <mxGeometry y="30" width="300" height="110" as="geometry" />
        </mxCell>
        
        <!-- Gestion des erreurs -->
        <mxCell id="error-handling" value="Gestion des Erreurs" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="450" y="500" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="error-details" value="• Timeout: Arrêt après 30 minutes&#10;• Mémoire insuffisante: Réduction batch size&#10;• Divergence: Réduction learning rate&#10;• Données corrompues: Rollback vers ancien&#10;• Échec validation: Conservation ancien modèle&#10;• Erreur système: Alerte administrateur&#10;• Retry automatique: 3 tentatives max" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="error-handling">
          <mxGeometry y="30" width="300" height="130" as="geometry" />
        </mxCell>
        
