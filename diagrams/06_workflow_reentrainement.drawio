        <!-- Titre -->
        <mxCell id="title" value="Workflow de Réentraînement Asynchrone" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="360" height="30" as="geometry" />
        </mxCell>
        
        <!-- Événements déclencheurs -->
        <mxCell id="triggers" value="ÉVÉNEMENTS DÉCLENCHEURS" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="triggers-details" value="• Nouvelle évaluation utilisateur&#10;• Seuil d'évaluations atteint (+100 ratings)&#10;• Réentraînement programmé (hebdomadaire)&#10;• Détection de dérive des performances&#10;• Ajout de nouveaux livres significatifs&#10;• Demande manuelle d'administrateur" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="triggers">
          <mxGeometry y="30" width="350" height="110" as="geometry" />
        </mxCell>
        
        <!-- Vérification conditions -->
        <mxCell id="conditions" value="VÉRIFICATION CONDITIONS" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;" vertex="1" parent="1">
          <mxGeometry x="50" y="260" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="conditions-details" value="• Nouvelles données suffisantes ? (≥ 100 ratings)&#10;• Temps écoulé depuis dernier ? (≥ 24h)&#10;• Ressources système disponibles ? (CPU, RAM)&#10;• Aucun réentraînement en cours ?&#10;• Modèle actuel stable ?" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="conditions">
          <mxGeometry y="30" width="350" height="100" as="geometry" />
        </mxCell>
        
        <!-- Extraction des données -->
        <mxCell id="extraction" value="EXTRACTION DES DONNÉES" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;" vertex="1" parent="1">
          <mxGeometry x="50" y="430" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="extraction-details" value="• Requête PostgreSQL pour récupérer ratings&#10;• Filtrage données selon critères qualité&#10;• Préparation datasets train/validation (80/20)&#10;• Sauvegarde des données pour reproductibilité&#10;• Vérification de l'intégrité des données" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="extraction">
          <mxGeometry y="30" width="350" height="100" as="geometry" />
        </mxCell>
        
        <!-- Réentraînement asynchrone -->
        <mxCell id="training" value="RÉENTRAÎNEMENT ASYNCHRONE" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#e8f5e8;strokeColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="training-details" value="• Création d'un thread de background&#10;• Chargement et compilation modèle TensorFlow&#10;• Entraînement avec validation croisée&#10;• Surveillance des métriques (RMSE, MAE)&#10;• Arrêt précoce si surapprentissage&#10;• Logging détaillé du processus&#10;• Gestion des erreurs et rollback" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="training">
          <mxGeometry y="30" width="350" height="120" as="geometry" />
        </mxCell>
        
        <!-- Validation du modèle -->
        <mxCell id="validation" value="VALIDATION DU MODÈLE" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ff8f00;" vertex="1" parent="1">
          <mxGeometry x="50" y="790" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="validation-details" value="• Évaluation sur données de test&#10;• Comparaison avec l'ancien modèle&#10;• Validation des performances minimales&#10;• Tests de cohérence des prédictions&#10;• Vérification de la stabilité numérique" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="validation">
          <mxGeometry y="30" width="350" height="100" as="geometry" />
        </mxCell>
        
        <!-- Déploiement -->
        <mxCell id="deployment" value="DÉPLOIEMENT DU MODÈLE" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#ad1457;" vertex="1" parent="1">
          <mxGeometry x="50" y="960" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="deployment-details" value="• Sauvegarde du nouveau modèle sur disque&#10;• Rechargement dans les services actifs&#10;• Mise à jour des métadonnées (date, version)&#10;• Notification de fin de processus&#10;• Archivage de l'ancien modèle&#10;• Test de smoke du nouveau modèle&#10;• Mise à jour des statistiques" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="deployment">
